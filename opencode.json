{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "mcp": {
    "code-review": {
      "type": "local",
      "command": ["{env:REVIEW_PYTHON}", "-m", "mcp_servers.code_review_server"],
      "environment": {
        "PYTHONPATH": "{env:REVIEW_TOOL_ROOT}",
        "REVIEW_WORKSPACE": "{env:REVIEW_WORKSPACE}",
        "REVIEW_CHANGESET": "{env:REVIEW_CHANGESET}",
        "ENABLED_CHECKS": "{env:ENABLED_CHECKS}"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
