# Copy to .env and fill in real values. Never commit .env.

# GitHub
GITHUB_TOKEN=replace-with-personal-access-token
GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
GITHUB_API_BASE=https://api.github.com
GITHUB_REPO=praveenmatanam/AI_Agent_Monitor
GITHUB_CLONE_URL=https://github.com/praveenmatanam/AI_Agent_Monitor.git
WATCHED_BRANCH=main

# LLM: full OpenCode model id (provider/model). Log in once with `opencode auth login`
# (GitHub Copilot) and list the ids with `opencode models github-copilot`.
OPENCODE_MODEL=github-copilot/gpt-5-mini

# Checks
ENABLED_CHECKS=pylint
